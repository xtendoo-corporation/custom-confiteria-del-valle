<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Plantilla del reporte de trazabilidad -->
    <template id="report_traceability_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <h2>Informe de trazabilidad de producción</h2>

                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Fecha desde:</strong> <span t-field="o.date_from"/><br/>
                                <strong>Fecha hasta:</strong> <span t-field="o.date_to"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Producto:</strong> <span t-field="o.product_id"/><br/>
                                <strong>Lote:</strong> <span t-field="o.lot_id"/><br/>
                            </div>
                        </div>

                        <table class="table table-sm">
                            <thead>
                                <tr style="background-color: #f0f0f0;">
                                    <th>Fecha</th>
                                    <th>Producto terminado</th>
                                    <th>Lote</th>
                                    <th>Cantidad</th>
                                    <th>Componente</th>
                                    <th>Lote componente</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr t-att-class="'table-danger' if line.trace_status == 'missing' else 'table-success'">
                                        <td><span t-field="line.production_date"/></td>
                                        <td><span t-field="line.finished_product_id"/></td>
                                        <td><span t-field="line.finished_lot_id"/></td>
                                        <td>
                                            <span t-field="line.finished_qty"/>
                                            <span t-field="line.finished_uom_id"/>
                                        </td>
                                        <td><span t-field="line.component_product_id"/></td>
                                        <td><span t-field="line.component_lot_id"/></td>
                                        <td>
                                            <t t-if="line.trace_status == 'found'">
                                                <span class="badge badge-success">✓ Encontrado</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge badge-danger">⚠ No encontrado</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt32">
                            <div class="col-12">
                                <p><strong>Total de líneas:</strong> <t t-esc="len(o.line_ids)"/></p>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

