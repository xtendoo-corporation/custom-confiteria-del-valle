<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.cdv</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description_ecommerce']" position="before">
                <group string="Descripción de la web" name="website_selection_page">
                    <field name="website_selection_short_description"
                        placeholder="e.g. Nuestra tarta cremosa sobre base de galleta artesanal..." />
                    <field name="allergen_page_sequence"
                        placeholder="e.g. 10"
                        help="Orden en /alergenos: el valor menor aparece primero." />
                </group>
            </xpath>
            <xpath expr="//group[@name='product_template_images']" position="after">
                <group string="Alergenos" name="product_allergens" invisible="not sale_ok">
                    <field name="allergen_ids" widget="many2many_kanban" nolabel="1">
                        <kanban>
                            <field name="id" />
                            <field name="name" />
                            <field name="image" />
                            <templates>
                                <t t-name="card">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="o_kanban_image">
                                            <field name="image" widget="image"
                                                options="{'size': [40, 40]}"
                                                class="o_image_40_cover rounded" />
                                        </div>
                                        <div class="oe_kanban_details">
                                            <field name="name" class="fw-bold" />
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
    <!-- Vista lista con drag & drop para ordenar productos en /alergenos -->
    <record id="product_template_tree_allergen_order" model="ir.ui.view">
        <field name="name">product.template.tree.allergen.order</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list default_order="allergen_page_sequence">
                <field name="allergen_page_sequence" widget="handle"/>
                <field name="name"/>
                <field name="default_code" optional="show"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Acción para abrir la vista de orden -->
    <record id="action_product_allergen_order" model="ir.actions.act_window">
        <field name="name">Orden productos /alergenos</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_template_tree_allergen_order"/>
        <field name="domain">[('is_published', '=', True), ('sale_ok', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Arrastra los productos para definir su orden en la página de alérgenos.
            </p>
        </field>
    </record>

    <!-- Menú bajo Website -->
    <menuitem id="menu_allergen_order_root"
        name="Orden Alérgenos"
        parent="website.menu_website_global_configuration"
        action="action_product_allergen_order"
        sequence="90"/>
</odoo>
