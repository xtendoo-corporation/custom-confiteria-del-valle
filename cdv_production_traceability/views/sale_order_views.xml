<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_cdv_traceability" model="ir.ui.view">
        <field name="name">sale.order.form.cdv.traceability</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@id='create_invoice']" position="after">
                <button name="action_deliver_and_invoice" type="object"
                    string="Entregar y Facturar" class="oe_highlight"
                    invisible="state not in ['sale', 'done'] or invoice_count &gt; 0"
                    groups="sales_team.group_sale_salesman" />
            </xpath>
        </field>
    </record>
</odoo>