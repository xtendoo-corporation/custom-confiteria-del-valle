<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Tree de materia prima en uso -->
    <record id="view_cdv_raw_material_in_use_tree" model="ir.ui.view">
        <field name="name">cdv.raw.material.in.use.tree</field>
        <field name="model">cdv.raw.material.in.use</field>
        <field name="arch" type="xml">
            <list string="Materias primas en uso" decoration-muted="state=='finished'"
                decoration-success="state=='in_use'">
                <field name="product_id" />
                <field name="lot_id" />
                <field name="date_from" />
                <field name="date_to" />
                <field name="state" widget="badge" decoration-success="state=='in_use'"
                    decoration-muted="state=='finished'" />

                <field name="location_id" optional="hide" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <!-- Vista Form de materia prima en uso -->
    <record id="view_cdv_raw_material_in_use_form" model="ir.ui.view">
        <field name="name">cdv.raw.material.in.use.form</field>
        <field name="model">cdv.raw.material.in.use</field>
        <field name="arch" type="xml">
            <form string="Materia prima en uso">
                <header>
                    <button name="action_reopen" string="Reabrir" type="object"
                        class="btn-secondary" invisible="state=='in_use'" />
                    <field name="state" widget="statusbar" statusbar_visible="in_use,finished" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_cdv_forward_trace_report)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-search"
                                context="{'default_raw_material_id': product_id, 'default_raw_material_lot_id': lot_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Trazabilidad</span>
                                <span class="o_stat_text">hacia adelante</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id"
                                   domain="['|', ('cdv_is_raw_material', '=', True), ('cdv_is_finished_product', '=', True)]"
                                   options="{'no_create': True}" />
                            <field name="lot_id" domain="[('product_id', '=', product_id)]"
                                options="{'no_create': False, 'no_open': False}"
                                context="{'default_product_id': product_id, 'default_company_id': company_id}" />

                        </group>
                        <group>
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="location_id" options="{'no_create': True}" />
                            <field name="company_id" groups="base.group_multi_company"
                                options="{'no_create': True}" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Vista Kanban de materia prima en uso -->
    <record id="view_cdv_raw_material_in_use_kanban" model="ir.ui.view">
        <field name="name">cdv.raw.material.in.use.kanban</field>
        <field name="model">cdv.raw.material.in.use</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="product_id" />
                <field name="lot_id" />
                <field name="date_from" />
                <field name="state" />

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-10">
                                    <strong>
                                        <field name="product_id" />
                                    </strong>
                                </div>
                                <div class="col-2">
                                    <field name="state" widget="badge"
                                        decoration-success="state=='in_use'"
                                        decoration-muted="state=='finished'" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <span>Lote: <field name="lot_id" /></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 text-muted">
                                    <span>Desde: <field name="date_from" /></span>
                                </div>
                            </div>

                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Search de materia prima en uso -->
    <record id="view_cdv_raw_material_in_use_search" model="ir.ui.view">
        <field name="name">cdv.raw.material.in.use.search</field>
        <field name="model">cdv.raw.material.in.use</field>
        <field name="arch" type="xml">
            <search string="Buscar materias primas en uso">
                <field name="product_id" />
                <field name="lot_id" />
                <filter string="En uso" name="in_use" domain="[('state', '=', 'in_use')]" />
                <filter string="Finalizadas" name="finished" domain="[('state', '=', 'finished')]" />
                <separator />
                <filter string="Fecha" name="date_from" date="date_from" />
                <group>
                    <filter string="Producto" name="group_product"
                        context="{'group_by': 'product_id'}" />
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}" />
                    <filter string="Fecha inicio" name="group_date_from"
                        context="{'group_by': 'date_from'}" />
                    <filter string="Ubicación" name="group_location"
                        context="{'group_by': 'location_id'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Vista Calendar de materia prima en uso -->
    <record id="view_cdv_raw_material_in_use_calendar" model="ir.ui.view">
        <field name="name">cdv.raw.material.in.use.calendar</field>
        <field name="model">cdv.raw.material.in.use</field>
        <field name="arch" type="xml">
            <calendar string="Materias primas en uso" date_start="date_from" date_stop="date_to"
                color="product_id" mode="month" quick_create="0">
                <field name="product_id" />
                <field name="lot_id" />
                <field name="state" />
            </calendar>
        </field>
    </record>

    <!-- Acción para materias primas en uso -->
    <record id="action_cdv_raw_material_in_use" model="ir.actions.act_window">
        <field name="name">Materias primas en uso</field>
        <field name="res_model">cdv.raw.material.in.use</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay materias primas en uso
            </p>
            <p>
                Use el asistente "Poner en producción" para marcar una materia prima como en uso.
            </p>
        </field>
    </record>

</odoo>
