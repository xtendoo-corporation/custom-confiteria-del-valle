<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Definición del reporte de trazabilidad -->
    <record id="action_report_traceability" model="ir.actions.report">
        <field name="name">Informe de trazabilidad</field>
        <field name="model">cdv.production.trace.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cdv_production_traceability.report_traceability_document</field>
        <field name="report_file">cdv_production_traceability.report_traceability_document</field>
        <field name="binding_model_id" ref="model_cdv_production_trace_report"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Plantilla del reporte de trazabilidad -->
    <template id="report_traceability_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <h2>Informe de Producto Elaborado</h2>

                        <!-- Filtros y Resumen en dos columnas -->
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <h5>Filtros</h5>
                                <strong>Desde:</strong> <span t-field="o.date_from"/><strong> hasta </strong><span t-field="o.date_to"/><br/>
                                <strong>Producto:</strong>
                                <span t-if="o.product_id" t-field="o.product_id"/>
                                <span t-else="">Todos</span><br/>
                                <strong>Lote:</strong>
                                <span t-if="o.lot_id" t-field="o.lot_id"/>
                                <span t-else="">Todos</span><br/>
                            </div>
                            <div class="col-6">
                                <h5>Resumen</h5>
                                <strong>Total de producciones:</strong> <span t-esc="o.total_productions"/><br/>
                                <strong>Total de unidades producidas:</strong> 
                                <span t-esc="o.total_qty_produced"/>
                                <span t-esc="o.total_qty_uom_name"/><br/>
                                <strong>Total de componentes rastreados:</strong> <span t-esc="o.total_components"/><br/>
                            </div>
                        </div>

                        <!-- Tabla de trazabilidad -->
                        <table class="table table-sm table-borderless">
                            <thead>
                                <tr style="background-color: #f5f5f5; color: #000;">
                                    <th>Fecha</th>
                                    <th>Cantidad Producida</th>
                                    <th>Materia Prima</th>
                                    <th>Lote Materia Prima</th>
                                    <th>Cantidad Estándar</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.production_date"/></td>
                                        <td>
                                            <span t-field="line.finished_qty"/>
                                            <span t-field="line.finished_uom_id"/>
                                        </td>
                                        <td><span t-field="line.component_product_id"/></td>
                                        <td>
                                            <span t-if="line.component_lot_id" t-field="line.component_lot_id"/>
                                            <span t-else="" style="color: #999;">-</span>
                                        </td>
                                        <td>
                                            <span t-field="line.component_qty_standard"/>
                                        </td>
                                        <td>
                                            <t t-if="line.trace_status == 'found'">
                                                <span style="border: 1px solid #333; padding: 2px 6px;">Encontrado</span>
                                            </t>
                                            <t t-else="">
                                                <span style="border: 1px solid #333; padding: 2px 6px;">No encontrado</span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt16">
                            <div class="col-12 text-muted">
                                <small>
                                    <strong>Total de registros:</strong> <t t-esc="len(o.line_ids)"/> líneas
                                </small>
                            </div>
                        </div>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>

