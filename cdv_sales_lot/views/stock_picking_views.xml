<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_detailed_operation_tree_inherit_cdv" model="ir.ui.view">
        <field name="name">stock.move.line.operations.tree.inherit.cdv</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="lot_qty_insufficient" column_invisible="1" />
                <button name="action_lot_warning"
                    type="object"
                    class="btn btn-link text-danger"
                    icon="fa-warning"
                    invisible="not lot_qty_insufficient"
                    title="Ver lotes disponibles" />
            </xpath>
        </field>
    </record>
</odoo>