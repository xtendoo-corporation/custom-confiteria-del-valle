<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="cdv_pos_auto_lot.ReceiptHeaderCompat"
       t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('custom-header')]" position="attributes">
            <attribute name="class" add="pos-receipt-contact" separator=" "/>
            <attribute name="style" add="width: 100%; white-space: normal; overflow-wrap: anywhere; word-break: break-word;" separator="; "/>
        </xpath>
    </t>

    <t t-name="cdv_pos_auto_lot.OrderReceiptFix"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//ReceiptHeader" position="replace">
            <t t-set="data" t-value="order.raw || order"/>
            <t t-set="company"
               t-value="data.company || (env &amp;&amp; env.pos &amp;&amp; env.pos.company_printable) || (env &amp;&amp; env.pos &amp;&amp; env.pos.company) || order.company || {}"/>
            <t t-set="companyName"
               t-value="getReceiptCompanyName(order, data, company)"/>
            <t t-set="companyNameLines" t-value="getReceiptCompanyNameLines(companyName, 18)"/>
            <t t-set="logoUrl" t-value="getReceiptLogoUrl(order, data, company)"/>
            <t t-set="partner"
               t-value="order.get_partner ? order.get_partner() : (order.partner_id || order.partner || null)"/>

            <t t-if="order.config._self_order_pos">
                <div t-if="order.preset_id or order.config.self_ordering_mode !== 'nothing'" class="picking-service text-center pt-3">
                    <span t-if="order.preset_id?.identification == 'none' or (!order.preset_id and order.config.self_ordering_service_mode == 'table')">Service at Table</span>
                    <span t-elif="order.preset_id?.identification == 'name' or (!order.preset_id and order.config.self_ordering_service_mode != 'table')">Pickup At Counter</span>
                    <span t-else="">Delivery</span>
                </div>
                <h1 t-if="order.tracking_number and order.config.displayBigTrackingNumber" class="tracking-number text-center" style="font-size: 100px" t-out="order.tracking_number"/>
                <div t-if="order.config.self_ordering_mode !== 'nothing' and order.table_stand_number" class="table-tracker text-center">
                    Table Tracker:
                    <span class="pt-3" t-out="order.table_stand_number"/>
                </div>
            </t>

            <div class="pos-receipt-contact" style="width: 100%;">
                <div class="custom-header"
                     style="font-family: 'Lucida Console', 'DejaVu Sans Mono', 'Liberation Mono', monospace; font-weight: normal; text-align: center; font-size: 13px; line-height: 1.2; padding: 0; margin: 0; width: 100%; white-space: normal; overflow-wrap: anywhere; word-break: break-word;">

                    <div t-if="logoUrl" style="margin: 0 0 6px 0; width: 100%; text-align: center;">
                        <img t-att-src="logoUrl"
                             alt="Logo"
                             class="pos-receipt-logo"
                             style="display: block; max-width: 50%; max-height: 90px; width: auto; height: auto; margin: 0 auto; object-fit: contain;"/>
                    </div>

                    <div style="margin-top: 5px; margin-bottom: 3px; font-weight: bold; width: 100%; white-space: normal; overflow-wrap: anywhere; word-break: break-word;">
                        <t t-if="companyNameLines.length">
                            <t t-foreach="companyNameLines" t-as="companyNameLine" t-key="companyNameLine_index">
                                <t t-esc="companyNameLine"/>
                                <br t-if="companyNameLine_index + 1 &lt; companyNameLines.length"/>
                            </t>
                        </t>
                        <t t-else="">
                            <t t-esc="companyName"/>
                        </t>
                    </div>
                    <div style="font-size: 10px;">
                        <t t-if="company.street">
                            <t t-esc="company.street"/>
                            <br/>
                        </t>
                        <t t-if="company.zip || company.city || company.street2">
                            <t t-if="company.street2">
                                <t t-esc="company.street2"/>
                                <br/>
                            </t>
                            <t t-esc="company.zip || ''"/>
                            <t t-if="company.city">
                                <t t-esc="(company.zip ? ' ' : '') + company.city"/>
                            </t>
                            <br/>
                        </t>
                        <t t-if="!company.street and !company.street2 and company.contact_address">
                            <t t-foreach="company.contact_address.split('\n')" t-as="addressLine" t-key="addressLine_index">
                                <t t-if="addressLine and addressLine.trim()">
                                    <t t-esc="addressLine"/>
                                    <br/>
                                </t>
                            </t>
                        </t>
                        <t t-if="company.phone">
                            Tlf <t t-esc="company.phone"/>
                            <br/>
                        </t>
                        <t t-if="company.vat">
                            <t t-esc="company.vat"/>
                        </t>
                    </div>

                    <div style="border-top: 1px dashed black; margin: 4px 0;"/>

                    <div style="font-size: 10px; text-align: left; padding: 0;">
                        <div style="margin-bottom: 2px;">
                            <strong>FACTURA SIMPLIFICADA:</strong> <t t-esc="order.name || order.pos_reference || ''"/>
                        </div>
                        <div style="margin-bottom: 2px;">
                            <strong>FECHA:</strong>
                            <t t-if="order.date_order" t-out="order.formatDateOrTime('date_order')"/>
                        </div>

                        <t t-if="partner">
                            <div style="margin-bottom: 2px;">
                                <strong>CLIENTE:</strong> <t t-esc="partner.name || partner.display_name || ''"/>
                            </div>
                            <t t-if="partner.vat">
                                <div style="margin-bottom: 2px;">
                                    <strong>NIF/CIF:</strong> <t t-esc="partner.vat"/>
                                </div>
                            </t>
                            <t t-if="partner.street || partner.city">
                                <div style="margin-bottom: 2px;">
                                    <t t-esc="partner.street || ''"/>
                                    <t t-if="partner.street and partner.city"> - </t>
                                    <t t-esc="partner.city || ''"/>
                                    <t t-if="partner.zip"> (<t t-esc="partner.zip"/>)</t>
                                </div>
                            </t>
                        </t>
                    </div>

                    <div style="border-top: 1px dashed black; margin: 4px 0;"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@t-if='line.customerNote']" position="replace">
            <t t-set="lineCustomerNote"
               t-value="getReceiptNoteDisplay(line)"/>
            <div t-if="lineCustomerNote"
                 style="font-size: 9px; font-style: italic; margin-left: 3px; margin-bottom: 1px; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-word;">
                [<t t-esc="lineCustomerNote"/>]
            </div>
        </xpath>
    </t>
</templates>

