<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="cdv_pos_auto_lot.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'pos-receipt-contact')]" position="replace">
            <div class="pos-receipt-contact text-center">
                <div class="fw-bold" style="white-space: normal; overflow-wrap: anywhere;">
                    <t t-esc="order.company.name"/>
                </div>
                <div t-if="order.config.receipt_header" style="white-space:pre-line" t-esc="order.config.receipt_header" />
                <div t-if="order?.getCashierName()" class="cashier">
                    <div>Served by: <t t-esc="order.getCashierName()" /></div>
                </div>
                <div t-if="order.tracking_number and order.config.displayTrackingNumber and !order.config.displayBigTrackingNumber">
                    <span class="tracking-number fs-1" t-esc="order.tracking_number" />
                </div>
            </div>
        </xpath>
    </t>
</templates>
