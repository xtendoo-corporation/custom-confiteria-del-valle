<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="cdv_pos_auto_lot.ReceiptHeaderConfiteria" t-inherit="todopintura_pos_custom.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('custom-header')]/div[1]" position="replace">
            <div style="margin-top: 5px; margin-bottom: 3px; font-weight: bold;">
                <t t-esc="'CONFITERIA NTRA SRA DEL VALLE'"/>
            </div>
        </xpath>
    </t>

    <t t-name="cdv_pos_auto_lot.OrderReceiptConfiteria" t-inherit="todopintura_pos_custom.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//t[@t-esc=&quot;line.custom_line_name || line.name || line.product_id.display_name&quot;]" position="replace">
            <t t-esc="((line.custom_line_name || line.name || line.product_id.display_name || '').replaceAll('Bandejas', 'Bandeja').replaceAll('bandejas', 'bandeja').replaceAll('Unidades', 'Uds').replaceAll('unidades', 'uds'))"/>
        </xpath>

        <xpath expr="//div[@t-if='line.customerNote']" position="replace">
            <div t-if="(line.getPrintableLineNote &amp;&amp; line.getPrintableLineNote()) || line.customerNote"
                 style="font-size: 9px; font-style: italic; margin-left: 3px; margin-bottom: 1px;">
                [<t t-esc="(line.getPrintableLineNote &amp;&amp; line.getPrintableLineNote()) || line.customerNote"/>]
            </div>
        </xpath>
    </t>
</templates>
