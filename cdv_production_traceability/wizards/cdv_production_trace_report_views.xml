<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Tree de las líneas de trazabilidad -->
    <record id="view_cdv_production_trace_report_line_tree" model="ir.ui.view">
        <field name="name">cdv.production.trace.report.line.tree</field>
        <field name="model">cdv.production.trace.report.line</field>
        <field name="arch" type="xml">
            <list decoration-danger="trace_status == 'missing'" decoration-success="trace_status == 'found'" create="false" edit="false" delete="false">
                <field name="production_date"/>
                <field name="finished_product_id"/>
                <field name="finished_lot_id"/>
                <field name="finished_qty"/>
                <field name="finished_uom_id"/>
                <field name="component_product_id"/>
                <field name="component_qty_standard"/>
                <field name="component_lot_id"/>
                <field name="trace_status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Vista Form del wizard de trazabilidad -->
    <record id="view_cdv_production_trace_report_form" model="ir.ui.view">
        <field name="name">cdv.production.trace.report.form</field>
        <field name="model">cdv.production.trace.report</field>
        <field name="arch" type="xml">
            <form string="Informe de trazabilidad">
                <header>
                    <button string="Calcular trazabilidad" name="action_compute_trace" type="object"
                            class="btn-primary" invisible="state == 'computed'"/>
                    <button string="Imprimir informe" name="action_print_report" type="object"
                            class="btn-primary" invisible="state != 'computed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Filtros">
                            <field name="company_id" invisible="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="lot_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook invisible="state != 'computed'">
                        <page string="Trazabilidad" name="trace_lines">
                            <field name="line_ids" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del wizard -->
    <record id="action_cdv_production_trace_report" model="ir.actions.act_window">
        <field name="name">Informe de trazabilidad</field>
        <field name="res_model">cdv.production.trace.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>

