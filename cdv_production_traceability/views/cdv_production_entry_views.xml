<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Tree de parte de producción -->
    <record id="view_cdv_production_entry_tree" model="ir.ui.view">
        <field name="name">cdv.production.entry.tree</field>
        <field name="model">cdv.production.entry</field>
        <field name="arch" type="xml">
            <tree string="Partes de producción" decoration-muted="state=='cancelled'" decoration-info="state=='draft'">
                <field name="name" decoration-bf="1"/>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="total_lines"/>
                <field name="picking_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-success="state=='done'"
                       decoration-muted="state=='cancelled'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form de parte de producción -->
    <record id="view_cdv_production_entry_form" model="ir.ui.view">
        <field name="name">cdv.production.entry.form</field>
        <field name="model">cdv.production.entry</field>
        <field name="arch" type="xml">
            <form string="Parte de producción">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_view_picking" string="Ver albarán" type="object"
                            class="btn-primary" invisible="not picking_id"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Volver a borrador" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Albarán</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="picking_type_id" options="{'no_create': True}"/>
                            <field name="location_src_id" readonly="1" optional="hide"/>
                            <field name="location_dest_id" readonly="1"/>
                            <field name="picking_id" readonly="1" optional="hide"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de producción" name="lines">
                            <field name="line_ids" widget="section_and_note_one2many">
                                <tree string="Productos producidos" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"
                                           domain="[('detailed_type', '=', 'product')]"
                                           required="1"/>
                                    <field name="quantity" sum="total_quantity"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="lot_id" optional="show"/>
                                    <field name="has_bom" column_invisible="1"/>
                                    <field name="bom_id" optional="hide" readonly="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="date" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Notas adicionales sobre este parte de producción..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Kanban de parte de producción -->
    <record id="view_cdv_production_entry_kanban" model="ir.ui.view">
        <field name="name">cdv.production.entry.kanban</field>
        <field name="model">cdv.production.entry</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
                <field name="total_lines"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-8">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="col-4">
                                    <field name="state" widget="badge"
                                           decoration-info="state=='draft'"
                                           decoration-success="state=='done'"
                                           decoration-muted="state=='cancelled'"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <span>Fecha: <field name="date"/></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <span>Líneas: <field name="total_lines"/></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 text-muted">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vista Calendar de parte de producción -->
    <record id="view_cdv_production_entry_calendar" model="ir.ui.view">
        <field name="name">cdv.production.entry.calendar</field>
        <field name="model">cdv.production.entry</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de producción" date_start="date" color="state"
                      quick_create="0" mode="month">
                <field name="name"/>
                <field name="total_lines"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Vista Search de parte de producción -->
    <record id="view_cdv_production_entry_search" model="ir.ui.view">
        <field name="name">cdv.production.entry.search</field>
        <field name="model">cdv.production.entry</field>
        <field name="arch" type="xml">
            <search string="Buscar partes de producción">
                <field name="name"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="picking_id"/>
                <filter string="Borradores" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmados" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelados" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Fecha" name="date" date="date"/>
                <filter string="Hoy" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Esta semana" name="this_week"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Este mes" name="this_month"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Responsable" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Tipo de albarán" name="group_picking_type" context="{'group_by': 'picking_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para partes de producción -->
    <record id="action_cdv_production_entry" model="ir.actions.act_window">
        <field name="name">Partes de producción diaria</field>
        <field name="res_model">cdv.production.entry</field>
        <field name="view_mode">tree,kanban,form,calendar</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear el primer parte de producción
            </p>
            <p>
                Los partes de producción diaria registran qué productos terminados se han elaborado
                y generan automáticamente los albaranes de entrada correspondientes.
            </p>
        </field>
    </record>

</odoo>

