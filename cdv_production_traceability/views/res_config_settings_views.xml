<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extensión de vista de configuración -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cdv</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="after">
                <app string="Confitería del Valle - Trazabilidad" name="cdv_production_traceability">
                    <block title="Trazabilidad de Producción">
                        <setting>
                            <field name="cdv_raw_material_location_id" options="{'no_create': True}"/>
                            <div class="text-muted">
                                Ubicación predeterminada para materias primas
                            </div>
                        </setting>
                        <setting>
                            <field name="cdv_finished_location_id" options="{'no_create': True}"/>
                            <div class="text-muted">
                                Ubicación predeterminada para productos terminados
                            </div>
                        </setting>
                        <setting>
                            <field name="cdv_auto_validate_picking"/>
                            <div class="text-muted">
                                Validar automáticamente los albaranes al confirmar partes de producción
                            </div>
                        </setting>
                        <setting>
                            <field name="cdv_finished_picking_type_id" options="{'no_create': True}" domain="[('code', 'in', ['incoming', 'internal'])]"/>
                            <div class="text-muted">
                                Tipo de albarán para productos terminados
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>

