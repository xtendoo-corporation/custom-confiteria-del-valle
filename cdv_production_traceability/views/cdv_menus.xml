<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción para Partes de Producción -->
    <record id="action_production_picking" model="ir.actions.act_window">
        <field name="name">Partes de Producción</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_production_entry', '=', True)]</field>
        <field name="context">{
            'default_is_production_entry': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo parte de producción
            </p>
            <p>
                Los partes de producción permiten registrar múltiples productos
                elaborados simultáneamente con un mismo lote.
            </p>
        </field>
    </record>

    <!-- Menú principal de Producción -->
    <menuitem id="menu_cdv_production_root"
              name="Producción"
              sequence="50"
              groups="group_cdv_production_user"
              web_icon="cdv_production_traceability,static/description/icon.png"/>

    <!-- Submenú: Materias primas -->
    <menuitem id="menu_cdv_raw_materials"
              name="Materias primas"
              parent="menu_cdv_production_root"
              sequence="10"
              groups="group_cdv_production_user"/>

    <menuitem id="menu_cdv_raw_material_in_use"
              name="Materias primas en uso"
              parent="menu_cdv_raw_materials"
              action="action_cdv_raw_material_in_use"
              sequence="10"
              groups="group_cdv_production_user"/>

    <!-- Submenú: Productos -->
    <menuitem id="menu_cdv_products"
              name="Productos"
              parent="menu_cdv_production_root"
              sequence="15"
              groups="group_cdv_production_user"/>

    <menuitem id="menu_cdv_products_products"
              name="Productos"
              parent="menu_cdv_products"
              action="product.product_template_action"
              sequence="10"
              groups="group_cdv_production_user"/>

    <menuitem id="menu_cdv_products_bom"
              name="Listas de materiales"
              parent="menu_cdv_products"
              action="mrp.mrp_bom_form_action"
              sequence="20"
              groups="group_cdv_production_user"/>

    <!-- Submenú: Producción -->
    <menuitem id="menu_cdv_production"
              name="Producción diaria"
              parent="menu_cdv_production_root"
              sequence="20"
              groups="group_cdv_production_user"/>

    <menuitem id="menu_cdv_production_entry"
              name="Partes de producción"
              parent="menu_cdv_production"
              action="action_production_picking"
              sequence="10"
              groups="group_cdv_production_user"/>

    <!-- Submenú: Informes -->
    <menuitem id="menu_cdv_reports"
              name="Informes"
              parent="menu_cdv_production_root"
              sequence="30"
              groups="group_cdv_production_user"/>

    <menuitem id="menu_cdv_trace_report"
              name="Informe de Producto Elaborado"
              parent="menu_cdv_reports"
              action="action_cdv_production_trace_report"
              sequence="10"
              groups="group_cdv_production_user"/>

    <menuitem id="menu_cdv_forward_trace_report"
              name="Informe de Materia Prima"
              parent="menu_cdv_reports"
              action="action_cdv_forward_trace_report"
              sequence="20"
              groups="group_cdv_production_user"/>

    <!-- Submenú: Configuración -->
    <menuitem id="menu_cdv_configuration"
              name="Configuración"
              parent="menu_cdv_production_root"
              sequence="90"
              groups="group_cdv_production_manager"/>

</odoo>

