<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vistas de árbol para las líneas del informe -->
    <record id="view_cdv_forward_trace_report_line_tree" model="ir.ui.view">
        <field name="name">cdv.forward.trace.report.line.tree</field>
        <field name="model">cdv.forward.trace.report.line</field>
        <field name="arch" type="xml">
            <list string="Productos finales donde se utilizó la materia prima">
                <field name="production_date"/>
                <field name="finished_product_id"/>
                <field name="finished_lot_id"/>
                <field name="finished_qty" sum="Total producido"/>
                <field name="finished_uom_id"/>
                <field name="component_qty_per_unit" optional="hide"/>
                <field name="usage_date_from" optional="show"/>
                <field name="usage_date_to" optional="show"/>
                <field name="production_entry_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_cdv_forward_trace_report_line_tree_simple" model="ir.ui.view">
        <field name="name">cdv.forward.trace.report.line.tree.simple</field>
        <field name="model">cdv.forward.trace.report.line</field>
        <field name="arch" type="xml">
            <list string="Detalle por producto">
                <field name="finished_product_id"/>
                <field name="finished_lot_id"/>
                <field name="production_date"/>
                <field name="finished_qty" sum="Total"/>
                <field name="finished_uom_id"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario del wizard de trazabilidad hacia adelante -->
    <record id="view_cdv_forward_trace_report_form" model="ir.ui.view">
        <field name="name">cdv.forward.trace.report.form</field>
        <field name="model">cdv.forward.trace.report</field>
        <field name="arch" type="xml">
            <form string="Informe de Materia Prima" create="false">
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not warning_message">
                        <field name="warning_message" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Filtros">
                            <field name="company_id" invisible="1"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="raw_material_id" options="{'no_create': True}"/>
                            <field name="raw_material_lot_id" options="{'no_create': True}" domain="[('product_id', '=', raw_material_id)]"/>
                        </group>
                        <group string="Resumen" invisible="not line_ids">
                            <field name="total_finished_products" readonly="1"/>
                            <field name="total_productions" readonly="1"/>
                            <field name="total_qty_produced" readonly="1"/>
                        </group>
                    </group>
                    <group name="usage_period" string="Período de uso de la materia prima" invisible="not line_ids">
                        <field name="usage_period_start" readonly="1"/>
                        <field name="usage_period_end" readonly="1"/>
                    </group>
                    <notebook invisible="not line_ids">
                        <page string="Productos finales" name="finished_products">
                            <field name="line_ids" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Calcular trazabilidad" name="action_compute_trace" type="object"
                            class="btn-primary" invisible="line_ids"/>
                    <button string="Imprimir informe" name="action_print_report" type="object"
                            class="btn-primary" invisible="not line_ids"/>
                    <button string="Nueva búsqueda" name="action_reset" type="object"
                            class="btn-secondary" invisible="not line_ids"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción del wizard -->
    <record id="action_cdv_forward_trace_report" model="ir.actions.act_window">
        <field name="name">Informe de Materia Prima</field>
        <field name="res_model">cdv.forward.trace.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>


</odoo>

