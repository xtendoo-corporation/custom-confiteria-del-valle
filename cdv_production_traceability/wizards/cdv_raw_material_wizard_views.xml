<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Form del wizard - Paso 1: Selección de producto -->
    <record id="view_cdv_raw_material_wizard_form_step1" model="ir.ui.view">
        <field name="name">cdv.raw.material.wizard.form.step1</field>
        <field name="model">cdv.raw.material.wizard</field>
        <field name="arch" type="xml">
            <form string="Poner materia prima en producción">
                <group>
                    <field name="step" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <group string="Paso 1: Seleccione la materia prima" invisible="step != 'select_product'">
                    <field name="product_id"
                           domain="[('detailed_type', '=', 'product')]"
                           options="{'no_create': True, 'no_create_edit': True}"
                           placeholder="Buscar por nombre, código o código de barras..."
                           required="step == 'select_product'"/>
                    <field name="date_from"/>
                    <field name="location_id" options="{'no_create': True}"/>
                </group>
                <group string="Paso 2: Seleccione el lote" invisible="step != 'select_lot'">
                    <field name="product_id" readonly="1"/>
                    <field name="lot_id"
                           domain="[('id', 'in', available_lot_ids)]"
                           context="{'default_product_id': product_id, 'default_company_id': company_id}"
                           required="step == 'select_lot'"/>
                    <field name="available_lot_ids" invisible="1"/>
                    <field name="date_from"/>
                    <field name="location_id" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button string="Siguiente" name="action_select_product" type="object"
                            class="btn-primary" invisible="step != 'select_product'"/>
                    <button string="Atrás" name="action_back" type="object"
                            class="btn-secondary" invisible="step != 'select_lot'"/>
                    <button string="Poner en producción" name="action_put_in_production" type="object"
                            class="btn-primary" invisible="step != 'select_lot'"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Vista Kanban de productos para selección táctil -->
    <record id="view_product_product_kanban_raw_material" model="ir.ui.view">
        <field name="name">product.product.kanban.raw.material</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile o_kanban_small_column" create="false" edit="false" delete="false">
                <field name="id"/>
                <field name="name"/>
                <field name="default_code"/>
                <field name="barcode"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="card" class="row g-0 flex-row flex-nowrap">
                        <aside class="col-auto o_kanban_image_wrapper d-flex">
                            <div class="o_kanban_image d-flex justify-content-center align-items-center mx-auto my-2">
                                <img t-att-src="kanban_image('product.product', 'image_128', record.id.raw_value)"
                                     alt="Producto" class="img img-fluid"
                                     style="max-width: 100px; max-height: 100px;"/>
                            </div>
                        </aside>
                        <main class="col d-flex flex-column justify-content-between">
                            <div class="o_kanban_card_content p-3">
                                <div class="o_kanban_card_header d-flex mb-1">
                                    <div class="o_kanban_card_header_title">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_card_body">
                                    <field name="default_code" invisible="not default_code"/>
                                    <field name="barcode" invisible="not barcode"/>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción del wizard -->
    <record id="action_cdv_raw_material_wizard" model="ir.actions.act_window">
        <field name="name">Poner materia prima en producción</field>
        <field name="res_model">cdv.raw.material.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>

</odoo>

