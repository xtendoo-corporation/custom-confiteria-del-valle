<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_view_available_lots" model="ir.actions.act_window">
        <field name="name">Lotes Disponibles</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('location_id.usage', '=', 'internal'), ('quantity', '&gt;', 0),
            ('product_id', '=', context.get('default_product_id'))]</field>
    </record>

    <record id="view_order_form_inherit_cdv_sales_lot" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.cdv.sales.lot</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="lot_ids" widget="many2many_tags" optional="show"
                    domain="[('product_id', '=', product_id)]" />
                <field name="lot_available_qty" optional="show" readonly="1" string="Stock Lote"/>
                <field name="lot_qty_insufficient" column_invisible="1" />
                <button name="%(cdv_sales_lot.action_view_available_lots)d"
                    type="action"
                    context="{'default_product_id': product_id}"
                    class="btn btn-link pe-0 text-danger"
                    icon="fa-warning"
                    invisible="not lot_qty_insufficient"
                    title="Ver lotes disponibles" />
            </xpath>
        </field>
    </record>
</odoo>