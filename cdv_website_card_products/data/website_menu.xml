<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Page Definition -->
        <record id="nuestra_carta_page_record" model="website.page">
            <field name="name">Nuestra Carta</field>
            <field name="url">/nuestra-carta</field>
            <field name="view_id" ref="nuestra_carta_page"/>
            <field name="is_published">True</field>
            <field name="track">True</field>
        </record>

        <!-- Menu Definition -->
        <record id="menu_nuestra_carta" model="website.menu">
            <field name="name">Nuestra Carta</field>
            <field name="page_id" ref="nuestra_carta_page_record"/>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence" type="int">20</field>
        </record>
    </data>
</odoo>
