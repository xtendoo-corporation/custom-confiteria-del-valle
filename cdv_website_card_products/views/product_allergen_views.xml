<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_allergen_view_tree" model="ir.ui.view">
        <field name="name">product.allergen.list</field>
        <field name="model">product.allergen</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="image" widget="image" options="{'size': [64, 64]}"/>
            </list>
        </field>
    </record>

    <record id="product_allergen_action" model="ir.actions.act_window">
        <field name="name">Product Allergens</field>
        <field name="res_model">product.allergen</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_product_allergen"
              name="Alergenos"
              action="product_allergen_action"
              parent="website_sale.menu_catalog"
              sequence="30"/>
</odoo>
